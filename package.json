{
    "name": "fo-data-hh3",
    "version": "1.0.0",
    "private": true,
    "description": "Horus Heresy 3rd Edition rules data for the Force Org army list builder.",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "run-local": "npx http-server /Users/josephmassie/projects/force_org_data/hh3 -p 8080 --cors -c-1",
        "check-version": "node scripts/version-sync.mjs",
        "sync-version": "node scripts/version-sync.mjs --write",
        "validate": "npm run check-version && fo-validate .",
        "format": "prettier --write"
    },
    "devDependencies": {
        "@force-org/data-validator": "github:Force-Organization-Army-Builder/fo_data_validator#v1.13.0",
        "prettier": "^3.0.0"
    }
}
