    "specialRules": {
        "a-brother-betrayed": {
            "id": "a-brother-betrayed",
            "name": "A Brother Betrayed",
            "text": "This Gambit allows Saul Tarvitz to gain benefits when fighting specific opponents. While a Model with this Special Rule is in a Challenge with an enemy Model with the Emperor’s Children, World Eaters, Sons of Horus or Death Guard Traits, its Controlling Player can select the following Gambit: Bite of the Betrayed: This Gambit can only be selected during the first Face-Off Step of a Challenge. If this Gambit is selected, until this Challenge ends, modify this Model’s Weapon Skill, Strength and Toughness Characteristics by +1."
        },
        "mutable-tactics-emperors-children": {
            "id": "mutable-tactics-emperors-children",
            "name": "Unparalleled Skill (Mutable Tactics)",
            "text": "The IIIrd Legion have an affinity for single combat, and are a match for any other Legion’s warriors. Those who fight alongside them learn much from their perfect bladecraft. A Hit Test result of 4+ is always successful for Models subject to this benefit. If the Emperor’s Children Legion was selected for this Army’s Shattered Legions Trait, when making a Hit Test for a Melee Attack for a Model from that Army subject to the Mutable Tactics Special Rule, a result of 4+ is always successful."
        },
        "legion-specialists": {
            "id": "legion-specialists",
            "name": "Legion Specialists",
            "text": "If Models in this Unit would benefit from the Mutable Tactics Legion Tactica, they may only benefit from the bonus related to their Legion whose Trait was replaced as part of the Exemplars of the Legion Prime Advantage."
        }
    },
    "groups": {},
    "slotOptions": {
        "exemplars-of-the-legion-emperors-children": {
            "id": "exemplars-of-the-legion-emperors-children",
            "name": "Exemplars of the Legion (Emperor’s Children)",
            "text": "Add one additional Force Organisation Slot to the Detachment that includes the Unit selected to fill a Prime Force Organisation Slot with this Prime Advantage. The Slot added may be of any Battlefield Role other than High Command, Command, Warlord or Lord of War. Each Unit selected to fill such a Slot must be from the Legiones Astartes Army List, not include any Models that have the Unique Sub-Type, and have a Faction Trait that matches the Legion represented by the Model that was selected to fill the Slot with this Prime Advantage. All Models in any of these Units have their Faction Trait replaced with ‘Shattered Legions’ and have the Legion Specialists Special Rule. Only for a Unit with the Command Battlefield Role in a Shattered Legions Detachment.",
            "slotTag": "prime",
            "units": {
                "roles": ["command"]
            },
            "when": {
                "if": "contingent.is(subfaction:shattered-legions)",
                "message": "Shattered Legions Detachments only"
            },
            "effects": [
                {
                    "kind": "trait",
                    "add": ["Exemplars of the Legion"]
                },
                {
                    "kind": "slot",
                    "roleChoices": [
                        "retinue",
                        "elites",
                        "war-engine",
                        "troop",
                        "support",
                        "transport",
                        "heavy-assault",
                        "heavy-transport",
                        "armour",
                        "recon",
                        "fast-attack"
                    ],
                    "source": {
                        "faction": "legiones-astartes",
                        "subFactions": ["emperors-children"]
                    },
                    "units": {
                        "exclude": [
                            {
                                "profiles": {
                                    "anyOf": ["Unique"]
                                }
                            }
                        ]
                    },
                    "effects": [
                        {
                            "kind": "trait",
                            "replace": {
                                "from": [
                                    "Legiones Astartes",
                                    "Emperor’s Children"
                                ],
                                "to": "Shattered Legions"
                            }
                        },
                        {
                            "kind": "specialRule",
                            "rule": {
                                "id": "legion-specialists"
                            }
                        }
                    ]
                }
            ]
        }
    },
