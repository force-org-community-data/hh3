    "equipment": {
        "corvid-pattern-jump-pack": {
            "id": "corvid-pattern-jump-pack",
            "name": "Corvid Pattern Jump Pack",
            "text": "Any Model from the following list with the Raven Guard Trait may have one Corvid pattern jump pack selected for it for +10 Points per Model. Praetor with Jump Pack Centurion with Jump Pack Optae with Jump Pack Moritat A Model with a Corvid pattern jump pack has their Movement Characteristic set to 14 and replaces any instance of the Bulky (X) Special Rule with Bulky (3). Each time a Dangerous Terrain Test is made for a Model with a Corvid pattern jump pack, that Test is automatically passed."
        }
    },
    "upgrades": {
        "raven-guard-corvid-pattern-jump-pack": {
            "id": "raven-guard-corvid-pattern-jump-pack",
            "name": "Corvid Pattern Jump Pack",
            "description": "Any Praetor with Jump Pack, Centurion with Jump Pack, Optae with Jump Pack or Moritat with the Raven Guard Trait may have one Corvid pattern jump pack selected for it (Movement 14).",
            "perModel": {
                "type": "single"
            },
            "options": {
                "corvid-pattern-jump-pack": {
                    "id": "corvid-pattern-jump-pack",
                    "name": "Corvid Pattern Jump Pack",
                    "cost": {
                        "points": 10
                    },
