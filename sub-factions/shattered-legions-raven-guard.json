        "raven-guard-ravens-talons-pair-of-lightning-claws": {
            "id": "raven-guard-ravens-talons-pair-of-lightning-claws",
            "name": "Pair of Raven’s Talons",
            "description": "Any Model with the Command Sub-Type and the Raven Guard Trait may have its lightning claw exchanged for one Raven’s Talon, or its pair of lightning claws exchanged for one pair of Raven’s Talons.",
            "perModel": {
                "type": "single"
            },
            "options": {
                "pair-of-lightning-claws-to-pair-of-ravens-talons": {
                    "id": "pair-of-lightning-claws-to-pair-of-ravens-talons",
                    "name": "Pair of lightning claws to pair of Raven’s Talons",
                    "cost": {
                        "points": 0
                    },
                    "swaps": [
                        {
                            "from": {
                                "kind": "weapon",
                                "id": "pair-of-lightning-claws"
                            },
                            "to": {
