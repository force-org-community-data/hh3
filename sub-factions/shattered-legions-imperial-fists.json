    "specialRules": {
        "hammerblow": {
            "id": "hammerblow",
            "name": "Hammerblow",
            "text": "Alexis Polux can make an alternative attack during a Challenge. While a Model with this Special Rule is engaged in a Challenge, its Controlling Player can select the following Gambit: Hammerblow: While this Gambit is selected, this Model gains the Hammerblow Weapon Profile and may not choose to make attacks with any other Weapon in the Strike Step. Melee Weapon Melee Weapon IM AM SM AP D Special Rules Traits Hammerblow Hammerblow I 1 10 2 3 Critical Hit (6+) Power"
        },
        "void-commander": {
            "id": "void-commander",
            "name": "Void Commander",
            "text": "If a Model with this Special Rule joins a Breacher Squad Unit in Reserves, Models in that Unit gain the Deep Strike Special Rule while this Model is part of the Unit. In addition, when a Model with this Special Rule is deployed as part of a Deep Strike, that Model and each other Model in the same Unit gain the Feel No Pain (5+) Special Rule until the Controlling Player’s next Effects Sub-Phase."
        },
        "mutable-tactics-imperial-fists": {
            "id": "mutable-tactics-imperial-fists",
            "name": "Devastating Volleys (Mutable Tactics)",
            "text": "The Imperial Fists drill themselves and those they fight alongside to unleash coordinated volleys of bolter fire at even the shortest of ranges, striking down whole ranks of the foe. Models subject to this benefit can make Volley Attacks with bolters. If the Imperial Fists Legion was selected for this Army’s Shattered Legions Trait, when making a Volley Attack for a Model from that Army subject to the Mutable Tactics Special Rule, that Model can make Volley Attacks with a bolter as if it had the Assault Trait."
        },
        "legion-specialists": {
            "id": "legion-specialists",
            "name": "Legion Specialists",
            "text": "If Models in this Unit would benefit from the Mutable Tactics Legion Tactica, they may only benefit from the bonus related to their Legion whose Trait was replaced as part of the Exemplars of the Legion Prime Advantage."
        }
    },
    "groups": {},
    "slotOptions": {
        "exemplars-of-the-legion-imperial-fists": {
            "id": "exemplars-of-the-legion-imperial-fists",
            "name": "Exemplars of the Legion (Imperial Fists)",
            "text": "Add one additional Force Organisation Slot to the Detachment that includes the Unit selected to fill a Prime Force Organisation Slot with this Prime Advantage. The Slot added may be of any Battlefield Role other than High Command, Command, Warlord or Lord of War. Each Unit selected to fill such a Slot must be from the Legiones Astartes Army List, not include any Models that have the Unique Sub-Type, and have a Faction Trait that matches the Legion represented by the Model that was selected to fill the Slot with this Prime Advantage. All Models in any of these Units have their Faction Trait replaced with ‘Shattered Legions’ and have the Legion Specialists Special Rule. Only for a Unit with the Command Battlefield Role in a Shattered Legions Detachment.",
            "slotTag": "prime",
            "units": {
                "roles": ["command"]
            },
            "when": {
                "if": "contingent.is(subfaction:shattered-legions)",
                "message": "Shattered Legions Detachments only"
            },
            "effects": [
                {
                    "kind": "trait",
                    "add": ["Exemplars of the Legion"]
                },
                {
                    "kind": "slot",
                    "roleChoices": [
                        "retinue",
                        "elites",
                        "war-engine",
                        "troop",
                        "support",
                        "transport",
                        "heavy-assault",
                        "heavy-transport",
                        "armour",
                        "recon",
                        "fast-attack"
                    ],
                    "source": {
                        "faction": "legiones-astartes",
                        "subFactions": ["imperial-fists"]
                    },
                    "units": {
                        "exclude": [
                            {
                                "profiles": {
                                    "anyOf": ["Unique"]
                                }
                            }
                        ]
                    },
                    "effects": [
                        {
                            "kind": "trait",
                            "replace": {
                                "from": ["Legiones Astartes", "Imperial Fists"],
                                "to": "Shattered Legions"
                            }
                        },
                        {
                            "kind": "specialRule",
                            "rule": {
                                "id": "legion-specialists"
                            }
                        }
                    ]
                }
            ]
        }
    },
