{
    "$schema": "https://cdn.jsdelivr.net/gh/force-org-community-data/fo_data_validator@1/schema/sub-faction.schema.json",
    "id": "iron-pattern-cohort",
    "version": "1.0.0",
    "name": "Iron Pattern Cohort",
    "parent": {
        "faction": "solar-auxilia",
        "versions": ">=1.0.0 <2.0.0"
    },
    "group": "cohort-doctrine",
    "specialRules": {
        "iron-over-flesh": {
            "id": "iron-over-flesh",
            "name": "Iron over Flesh",
            "text": "Every Model in a Lasrifle Section Unit in an Army with the Iron Pattern Cohort Doctrine gains the Expendable (1) Special Rule."
        }
    },
    "unitModifiers": {
        "iron-over-flesh": {
            "id": "iron-over-flesh",
            "name": "Iron over Flesh",
            "selector": {
                "unitIds": ["lasrifle-section"]
            },
            "actions": [
                {
                    "kind": "specialRule",
                    "rule": {
                        "id": "expendable",
                        "value": "1"
                    }
                }
            ]
        },
        "iron-over-flesh-all": {
            "id": "iron-over-flesh-all",
            "name": "Iron over Flesh",
            "selector": {},
            "actions": [
                {
                    "kind": "specialRule",
                    "rule": {
                        "id": "iron-over-flesh"
                    }
                }
            ]
        }
    },
    "detachments": {
        "iron-tercio": {
            "id": "iron-tercio",
            "name": "Iron Tercio",
            "type": "auxiliary",
            "slots": [
                {
                    "roles": ["heavy-assault"],
                    "units": {
                        "unitIds": ["castellax-destructor-maniple"]
                    },
                    "source": {
                        "faction": "mechanicum-taghmata"
                    }
                },
                {
                    "roles": ["troop"],
                    "units": {
                        "unitIds": ["tech-priest"]
                    },
                    "source": {
                        "faction": "mechanicum-taghmata"
                    }
                },
                {
                    "roles": ["support"],
                    "units": {
                        "unitIds": [
                            "castellax-battle-maniple",
                            "thallax-cohort"
                        ]
                    },
                    "source": {
                        "faction": "mechanicum-taghmata"
                    }
                }
            ],
            "effects": [
                {
                    "kind": "trait",
                    "replace": {
                        "from": ["Mechanicum", "Cybernetica", "Reductor"],
                        "to": "Iron Tercio"
                    }
                }
            ],
            "description": "Iron Pattern Cohort only. Units are selected from Liber Mechanicum, a different Army List to the Detachment it is linked to. Heavy Assault Slots in this Detachment may only be used to select Castellax Destructor Maniple Units, Troops Slots in this Detachment may only be used to select Tech-Priest Units and Support Slots in this Detachment may only be used to select Castellax Battle Maniple or Thallax Cohort Units, each selected from Liber Mechanicum . Models selected as part of this Detachment replace their [Mechanicum], Cybernetica or Reductor Trait with the ‘Iron Tercio’ Faction Trait. Units selected as part of this Detachment which contain both one or more Tech-priests and one or more Models with the Automata Type may Hold, Control and Contest Objectives ."
        }
    }
}
