        "telekinesis": {
            "id": "telekinesis",
            "name": "Telekinesis",
            "text": "A Model with the Telekinesis Discipline gains the following benefits: the Shrouded (4+) Special Rule; the Force Barrier Psychic Reaction; the Immovable Force Psychic Weapon; the ‘Telekine’ Trait.",
            "weapon": {
                "template": "ranged",
