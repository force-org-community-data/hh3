    "specialRules": {
        "mutable-tactics-space-wolves": {
            "id": "mutable-tactics-space-wolves",
            "name": "Spirit of Fenris (Mutable Tactics)",
            "text": "The warriors of the VIth Legion have been observed surging forth to engage the foe without warning, inspiring their allies with their battle-lust. Models with this benefit can make longer Set-up Move s than normal. If the Space Wolves Legion was selected for this Army’s Shattered Legions Trait, when making a Set-up Move for a Model from that Army subject to the Mutable Tactics Special Rule, the Controlling Player can add +1\" to the distance moved, to a maximum of 6\"."
        },
        "legion-specialists": {
            "id": "legion-specialists",
            "name": "Legion Specialists",
            "text": "If Models in this Unit would benefit from the Mutable Tactics Legion Tactica, they may only benefit from the bonus related to their Legion whose Trait was replaced as part of the Exemplars of the Legion Prime Advantage."
        }
    },
    "groups": {},
    "slotOptions": {
        "exemplars-of-the-legion-space-wolves": {
            "id": "exemplars-of-the-legion-space-wolves",
            "name": "Exemplars of the Legion (Space Wolves)",
            "text": "Add one additional Force Organisation Slot to the Detachment that includes the Unit selected to fill a Prime Force Organisation Slot with this Prime Advantage. The Slot added may be of any Battlefield Role other than High Command, Command, Warlord or Lord of War. Each Unit selected to fill such a Slot must be from the Legiones Astartes Army List, not include any Models that have the Unique Sub-Type, and have a Faction Trait that matches the Legion represented by the Model that was selected to fill the Slot with this Prime Advantage. All Models in any of these Units have their Faction Trait replaced with ‘Shattered Legions’ and have the Legion Specialists Special Rule. Only for a Unit with the Command Battlefield Role in a Shattered Legions Detachment.",
            "slotTag": "prime",
            "units": {
                "roles": ["command"]
            },
            "when": {
                "if": "(contingent.is(subfaction:shattered-legions)) and not unit.is(@shattered-other-armouries-space-wolves)",
                "message": "Shattered Legions Detachments only; only for a Model representing the Space Wolves (no other Legion Armoury)"
            },
            "effects": [
                {
                    "kind": "slot",
                    "roleChoices": [
                        "retinue",
                        "elites",
                        "war-engine",
                        "troop",
                        "support",
                        "transport",
                        "heavy-assault",
                        "heavy-transport",
                        "armour",
                        "recon",
                        "fast-attack"
                    ],
                    "source": {
                        "faction": "legiones-astartes",
                        "subFactions": ["space-wolves"]
                    },
                    "units": {
                        "exclude": [
                            {
                                "profiles": {
                                    "anyOf": ["Unique"]
                                }
                            }
                        ]
                    },
                    "effects": [
                        {
                            "kind": "trait",
                            "replace": {
                                "from": ["Legiones Astartes", "Space Wolves"],
                                "to": "Shattered Legions"
                            }
                        },
                        {
                            "kind": "specialRule",
                            "rule": {
                                "id": "legion-specialists"
                            }
                        },
                        {
                            "kind": "trait",
                            "add": ["Exemplars of the Legion"]
                        }
                    ]
                }
            ]
        }
    },
