    "specialRules": {
        "mutable-tactics-iron-warriors": {
            "id": "mutable-tactics-iron-warriors",
            "name": "Accustomed to Devastation (Mutable Tactics)",
            "text": "The warriors of the IVth Legion stand firm in the face of even the most savage fusillade, their silent stoicism an inspiration to those who fight by their side. A Leadership Check result of 9 or less is always successful for Models subject to this benefit in the Shooting Phase. If the Iron Warriors Legion was selected for this Army’s Shattered Legions Trait, when making a Leadership Check in the Morale Sub-Phase for a Unit from that Army subject to the Mutable Tactics Special Rule, a result of 9 or less is always successful."
        },
        "legion-specialists": {
            "id": "legion-specialists",
            "name": "Legion Specialists",
            "text": "If Models in this Unit would benefit from the Mutable Tactics Legion Tactica, they may only benefit from the bonus related to their Legion whose Trait was replaced as part of the Exemplars of the Legion Prime Advantage."
        }
    },
    "groups": {},
    "slotOptions": {
        "exemplars-of-the-legion-iron-warriors": {
            "id": "exemplars-of-the-legion-iron-warriors",
            "name": "Exemplars of the Legion (Iron Warriors)",
            "text": "Add one additional Force Organisation Slot to the Detachment that includes the Unit selected to fill a Prime Force Organisation Slot with this Prime Advantage. The Slot added may be of any Battlefield Role other than High Command, Command, Warlord or Lord of War. Each Unit selected to fill such a Slot must be from the Legiones Astartes Army List, not include any Models that have the Unique Sub-Type, and have a Faction Trait that matches the Legion represented by the Model that was selected to fill the Slot with this Prime Advantage. All Models in any of these Units have their Faction Trait replaced with ‘Shattered Legions’ and have the Legion Specialists Special Rule. Only for a Unit with the Command Battlefield Role in a Shattered Legions Detachment.",
            "slotTag": "prime",
            "units": {
                "roles": ["command"]
            },
            "when": {
                "if": "(contingent.is(subfaction:shattered-legions)) and not unit.is(@shattered-other-armouries-iron-warriors)",
                "message": "Shattered Legions Detachments only; only for a Model representing the Iron Warriors (no other Legion Armoury)"
            },
            "effects": [
                {
                    "kind": "slot",
                    "roleChoices": [
                        "retinue",
                        "elites",
                        "war-engine",
                        "troop",
                        "support",
                        "transport",
                        "heavy-assault",
                        "heavy-transport",
                        "armour",
                        "recon",
                        "fast-attack"
                    ],
                    "source": {
                        "faction": "legiones-astartes",
                        "subFactions": ["iron-warriors"]
                    },
                    "units": {
                        "exclude": [
                            {
                                "profiles": {
                                    "anyOf": ["Unique"]
                                }
                            }
                        ]
                    },
                    "effects": [
                        {
                            "kind": "trait",
                            "replace": {
                                "from": ["Legiones Astartes", "Iron Warriors"],
                                "to": "Shattered Legions"
                            }
                        },
                        {
                            "kind": "specialRule",
                            "rule": {
                                "id": "legion-specialists"
                            }
                        },
                        {
                            "kind": "trait",
                            "add": ["Exemplars of the Legion"]
                        }
                    ]
                }
            ]
        }
    },
