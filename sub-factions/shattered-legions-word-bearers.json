    },
    "specialRules": {
        "mutable-tactics-word-bearers": {
            "id": "mutable-tactics-word-bearers",
            "name": "Zealous Devotion (Mutable Tactics)",
            "text": "The Word Bearers’ belief in their cause drives them forward, inspiring even the most intractable allies. When making a Charge Roll for a Unit that includes Models subject to this benefit, three Dice are rolled and the lowest two discarded. If the Word Bearers Legion was selected for this Army’s Shattered Legions Trait, when making a Charge Roll for a Unit that includes any Models from that Army subject to the Mutable Tactics Special Rule, the Controlling Player rolls one additional Dice and discards the two Dice with the lowest results."
        },
        "legion-specialists": {
            "id": "legion-specialists",
            "name": "Legion Specialists",
            "text": "If Models in this Unit would benefit from the Mutable Tactics Legion Tactica, they may only benefit from the bonus related to their Legion whose Trait was replaced as part of the Exemplars of the Legion Prime Advantage."
        }
    },
    "groups": {},
    "slotOptions": {
        "exemplars-of-the-legion-word-bearers": {
            "id": "exemplars-of-the-legion-word-bearers",
            "name": "Exemplars of the Legion (Word Bearers)",
            "text": "Add one additional Force Organisation Slot to the Detachment that includes the Unit selected to fill a Prime Force Organisation Slot with this Prime Advantage. The Slot added may be of any Battlefield Role other than High Command, Command, Warlord or Lord of War. Each Unit selected to fill such a Slot must be from the Legiones Astartes Army List, not include any Models that have the Unique Sub-Type, and have a Faction Trait that matches the Legion represented by the Model that was selected to fill the Slot with this Prime Advantage. All Models in any of these Units have their Faction Trait replaced with ‘Shattered Legions’ and have the Legion Specialists Special Rule. Only for a Unit with the Command Battlefield Role in a Shattered Legions Detachment.",
            "slotTag": "prime",
            "units": {
                "roles": ["command"]
            },
            "when": {
                "if": "(contingent.is(subfaction:shattered-legions)) and not unit.is(@shattered-other-armouries-word-bearers)",
                "message": "Shattered Legions Detachments only; only for a Model representing the Word Bearers (no other Legion Armoury)"
            },
            "effects": [
                {
                    "kind": "slot",
                    "roleChoices": [
                        "retinue",
                        "elites",
                        "war-engine",
                        "troop",
                        "support",
                        "transport",
                        "heavy-assault",
                        "heavy-transport",
                        "armour",
                        "recon",
                        "fast-attack"
                    ],
                    "source": {
                        "faction": "legiones-astartes",
                        "subFactions": ["word-bearers"]
                    },
                    "units": {
                        "exclude": [
                            {
                                "profiles": {
                                    "anyOf": ["Unique"]
                                }
                            }
                        ]
                    },
                    "effects": [
                        {
                            "kind": "trait",
                            "replace": {
                                "from": ["Legiones Astartes", "Word Bearers"],
                                "to": "Shattered Legions"
                            }
                        },
                        {
                            "kind": "specialRule",
                            "rule": {
                                "id": "legion-specialists"
                            }
                        },
                        {
                            "kind": "trait",
                            "add": ["Exemplars of the Legion"]
                        }
                    ]
                }
            ]
        }
    },
    "unitModifiers": {
        "shattered-legions-word-bearers-mutable-tactics": {
            "id": "shattered-legions-word-bearers-mutable-tactics",
