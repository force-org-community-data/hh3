    "specialRules": {
        "impact": {
            "id": "impact",
            "name": "Impact",
            "text": "On a successful Charge, a Model with the Impact (X) Special Rule temporarily increases a Characteristic by 1. If a Unit that includes any Models with the Impact (X) Special Rule or any Models that have any Weapons with the Impact (X) Special Rule, and that Unit makes a successful Charge, then this Special Rule is triggered. Once triggered, until the end of that Assault Phase, when making Melee Attacks for Models in that Unit, each Model or Weapon that is selected for one of those Models, that has a variant of this Special Rule gains a modifier of +1 to any Characteristics that is the value of X.",
            "configurable": true
        },
        "mutable-tactics-world-eaters": {
            "id": "mutable-tactics-world-eaters",
            "name": "Frenzied Pursuit (Mutable Tactics)",
            "text": "Warriors of the World Eaters cannot be restrained and will attempt to chase down even the swiftest of foes. Their allies are forced to follow in their wake, lest these foolhardy berserkers be overwhelmed. Models subject to this benefit move further when Pursuing. If the World Eaters Legion was selected for this Army’s Shattered Legions Trait, when a Unit that includes a Model from that Army subject to the Mutable Tactics Special Rule pursues an enemy Unit, the Controlling Player can add +2\" to the distance moved."
        },
        "legion-specialists": {
            "id": "legion-specialists",
            "name": "Legion Specialists",
            "text": "If Models in this Unit would benefit from the Mutable Tactics Legion Tactica, they may only benefit from the bonus related to their Legion whose Trait was replaced as part of the Exemplars of the Legion Prime Advantage."
        }
    },
    "groups": {},
    "slotOptions": {
        "exemplars-of-the-legion-world-eaters": {
            "id": "exemplars-of-the-legion-world-eaters",
            "name": "Exemplars of the Legion (World Eaters)",
            "text": "Add one additional Force Organisation Slot to the Detachment that includes the Unit selected to fill a Prime Force Organisation Slot with this Prime Advantage. The Slot added may be of any Battlefield Role other than High Command, Command, Warlord or Lord of War. Each Unit selected to fill such a Slot must be from the Legiones Astartes Army List, not include any Models that have the Unique Sub-Type, and have a Faction Trait that matches the Legion represented by the Model that was selected to fill the Slot with this Prime Advantage. All Models in any of these Units have their Faction Trait replaced with ‘Shattered Legions’ and have the Legion Specialists Special Rule. Only for a Unit with the Command Battlefield Role in a Shattered Legions Detachment.",
            "slotTag": "prime",
            "units": {
                "roles": ["command"]
            },
            "when": {
                "if": "contingent.is(subfaction:shattered-legions)",
                "message": "Shattered Legions Detachments only"
            },
            "effects": [
                {
                    "kind": "trait",
                    "add": ["Exemplars of the Legion"]
                },
                {
                    "kind": "slot",
                    "roleChoices": [
                        "retinue",
                        "elites",
                        "war-engine",
                        "troop",
                        "support",
                        "transport",
                        "heavy-assault",
                        "heavy-transport",
                        "armour",
                        "recon",
                        "fast-attack"
                    ],
                    "source": {
                        "faction": "legiones-astartes",
                        "subFactions": ["world-eaters"]
                    },
                    "units": {
                        "exclude": [
                            {
                                "profiles": {
                                    "anyOf": ["Unique"]
                                }
                            }
                        ]
                    },
                    "effects": [
                        {
                            "kind": "trait",
                            "replace": {
                                "from": ["Legiones Astartes", "World Eaters"],
                                "to": "Shattered Legions"
                            }
                        },
                        {
                            "kind": "specialRule",
                            "rule": {
                                "id": "legion-specialists"
                            }
                        }
                    ]
                }
            ]
        }
    },
