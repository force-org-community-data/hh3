    "specialRules": {
        "mutable-tactics-night-lords": {
            "id": "mutable-tactics-night-lords",
            "name": "Murderous Reputation (Mutable Tactics)",
            "text": "All know the dread fate that befalls those who fall beneath the blades of the sons of the Night Haunter. Even a few of these warriors can send a foe fleeing in terror. If any Models are destroyed by a Model subject to this benefit, the Controlling Player scores 1 additional Combat Resolution Point. If the Night Lords Legion was selected for this Army’s Shattered Legions Trait, if a Unit that includes any Models from that Army subject to the Mutable Tactics Special Rule causes any enemy Models to be Removed as a Casualty, the Controlling Player scores 1 additional Combat Resolution Point when resolving that Combat during that Player Turn."
        },
        "legion-specialists": {
            "id": "legion-specialists",
            "name": "Legion Specialists",
            "text": "If Models in this Unit would benefit from the Mutable Tactics Legion Tactica, they may only benefit from the bonus related to their Legion whose Trait was replaced as part of the Exemplars of the Legion Prime Advantage."
        }
    },
    "groups": {},
    "slotOptions": {
        "exemplars-of-the-legion-night-lords": {
            "id": "exemplars-of-the-legion-night-lords",
            "name": "Exemplars of the Legion (Night Lords)",
            "text": "Add one additional Force Organisation Slot to the Detachment that includes the Unit selected to fill a Prime Force Organisation Slot with this Prime Advantage. The Slot added may be of any Battlefield Role other than High Command, Command, Warlord or Lord of War. Each Unit selected to fill such a Slot must be from the Legiones Astartes Army List, not include any Models that have the Unique Sub-Type, and have a Faction Trait that matches the Legion represented by the Model that was selected to fill the Slot with this Prime Advantage. All Models in any of these Units have their Faction Trait replaced with ‘Shattered Legions’ and have the Legion Specialists Special Rule. Only for a Unit with the Command Battlefield Role in a Shattered Legions Detachment.",
            "slotTag": "prime",
            "units": {
                "roles": ["command"]
            },
            "when": {
                "if": "contingent.is(subfaction:shattered-legions)",
                "message": "Shattered Legions Detachments only"
            },
            "effects": [
                {
                    "kind": "slot",
                    "roleChoices": [
                        "retinue",
                        "elites",
                        "war-engine",
                        "troop",
                        "support",
                        "transport",
                        "heavy-assault",
                        "heavy-transport",
                        "armour",
                        "recon",
                        "fast-attack"
                    ],
                    "source": {
                        "faction": "legiones-astartes",
                        "subFactions": ["night-lords"]
                    },
                    "units": {
                        "exclude": [
                            {
                                "profiles": {
                                    "anyOf": ["Unique"]
                                }
                            }
                        ]
                    },
                    "effects": [
                        {
                            "kind": "trait",
                            "replace": {
                                "from": ["Legiones Astartes", "Night Lords"],
                                "to": "Shattered Legions"
                            }
                        },
                        {
                            "kind": "specialRule",
                            "rule": {
                                "id": "legion-specialists"
                            }
                        },
                        {
                            "kind": "trait",
                            "add": ["Exemplars of the Legion"]
                        }
                    ]
                }
            ]
        }
    },
