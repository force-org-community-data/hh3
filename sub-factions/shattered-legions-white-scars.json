    "specialRules": {
        "seeker-of-atonement": {
            "id": "seeker-of-atonement",
            "name": "Seeker of Atonement",
            "text": "This Gambit allows Hibou Khan to avoid being Removed as a Casualty. While a Model with this Special Rule is engaged in a Challenge, its Controlling Player can select the following Gambit: Seeker of Atonement: While this Gambit is selected, if this Model is reduced to 0 Wounds in Step 4 of the Strike Step, its Controlling Player can roll a Dice. On a result of 4+, this Model is not Removed as a Casualty but instead remains Engaged in the Challenge with a Wounds Characteristic of 1 and its Controlling Player gains Challenge Advantage."
        },
        "mutable-tactics-white-scars": {
            "id": "mutable-tactics-white-scars",
            "name": "Swift of Action (Mutable Tactics)",
            "text": "The White Scars fight ever on the front foot, able to swiftly take advantage of any opportunity they may create. Those who fight alongside them soon learn to capitalise on even the briefest opening. Models subject to this benefit have their Initiative modified by +1 while making Set-up Moves or Rushing. If the White Scars Legion was selected for this Army’s Shattered Legions Trait, when a Unit that only includes Models subject to the Mutable Tactics Special Rule makes a Set-up Move or is selected to Rush, modify the Initiative Characteristic of Models in that Unit by +1 until the end of that Sub-Phase."
        },
        "legion-specialists": {
            "id": "legion-specialists",
            "name": "Legion Specialists",
            "text": "If Models in this Unit would benefit from the Mutable Tactics Legion Tactica, they may only benefit from the bonus related to their Legion whose Trait was replaced as part of the Exemplars of the Legion Prime Advantage."
        }
    },
    "groups": {},
    "slotOptions": {
        "exemplars-of-the-legion-white-scars": {
            "id": "exemplars-of-the-legion-white-scars",
            "name": "Exemplars of the Legion (White Scars)",
            "text": "Add one additional Force Organisation Slot to the Detachment that includes the Unit selected to fill a Prime Force Organisation Slot with this Prime Advantage. The Slot added may be of any Battlefield Role other than High Command, Command, Warlord or Lord of War. Each Unit selected to fill such a Slot must be from the Legiones Astartes Army List, not include any Models that have the Unique Sub-Type, and have a Faction Trait that matches the Legion represented by the Model that was selected to fill the Slot with this Prime Advantage. All Models in any of these Units have their Faction Trait replaced with ‘Shattered Legions’ and have the Legion Specialists Special Rule. Only for a Unit with the Command Battlefield Role in a Shattered Legions Detachment.",
            "slotTag": "prime",
            "units": {
                "roles": ["command"]
            },
            "when": {
                "if": "(contingent.is(subfaction:shattered-legions)) and not unit.is(@shattered-other-armouries-white-scars)",
                "message": "Shattered Legions Detachments only; only for a Model representing the White Scars (no other Legion Armoury)"
            },
            "effects": [
                {
                    "kind": "slot",
                    "roleChoices": [
                        "retinue",
                        "elites",
                        "war-engine",
                        "troop",
                        "support",
                        "transport",
                        "heavy-assault",
                        "heavy-transport",
                        "armour",
                        "recon",
                        "fast-attack"
                    ],
                    "source": {
                        "faction": "legiones-astartes",
                        "subFactions": ["white-scars"]
                    },
                    "units": {
                        "exclude": [
                            {
                                "profiles": {
                                    "anyOf": ["Unique"]
                                }
                            }
                        ]
                    },
                    "effects": [
                        {
                            "kind": "trait",
                            "replace": {
                                "from": ["Legiones Astartes", "White Scars"],
                                "to": "Shattered Legions"
                            }
                        },
                        {
                            "kind": "specialRule",
                            "rule": {
                                "id": "legion-specialists"
                            }
                        },
                        {
                            "kind": "trait",
                            "add": ["Exemplars of the Legion"]
                        }
                    ]
                }
            ]
        }
    },
