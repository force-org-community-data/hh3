    "specialRules": {
        "mutable-tactics-alpha-legion": {
            "id": "mutable-tactics-alpha-legion",
            "name": "Assassination Tactics (Mutable Tactics)",
            "text": "The Alpha Legion have long studied even the most obscure uniform markings used throughout the Imperium, allowing them to identify and designate commanding officers to be struck down. Volley Attacks made for Models subject to this benefit gain the Precision (6+) Special Rule. If the Alpha Legion Legion was selected for this Army’s Shattered Legions Trait, when making Volley Attacks for a Model from that Army subject to the Mutable Tactics Special Rule, those attacks have the Precision (6+) Special Rule."
        },
        "legion-specialists": {
            "id": "legion-specialists",
            "name": "Legion Specialists",
            "text": "If Models in this Unit would benefit from the Mutable Tactics Legion Tactica, they may only benefit from the bonus related to their Legion whose Trait was replaced as part of the Exemplars of the Legion Prime Advantage."
        }
    },
    "groups": {},
    "slotOptions": {
        "exemplars-of-the-legion-alpha-legion": {
            "id": "exemplars-of-the-legion-alpha-legion",
            "name": "Exemplars of the Legion (Alpha Legion)",
            "text": "Add one additional Force Organisation Slot to the Detachment that includes the Unit selected to fill a Prime Force Organisation Slot with this Prime Advantage. The Slot added may be of any Battlefield Role other than High Command, Command, Warlord or Lord of War. Each Unit selected to fill such a Slot must be from the Legiones Astartes Army List, not include any Models that have the Unique Sub-Type, and have a Faction Trait that matches the Legion represented by the Model that was selected to fill the Slot with this Prime Advantage. All Models in any of these Units have their Faction Trait replaced with ‘Shattered Legions’ and have the Legion Specialists Special Rule. Only for a Unit with the Command Battlefield Role in a Shattered Legions Detachment.",
            "slotTag": "prime",
            "units": {
                "roles": ["command"]
            },
            "when": {
                "if": "(contingent.is(subfaction:shattered-legions)) and not unit.is(@shattered-other-armouries-alpha-legion)",
                "message": "Shattered Legions Detachments only; only for a Model representing the Alpha Legion (no other Legion Armoury)"
            },
            "effects": [
                {
                    "kind": "slot",
                    "roleChoices": [
                        "retinue",
                        "elites",
                        "war-engine",
                        "troop",
                        "support",
                        "transport",
                        "heavy-assault",
                        "heavy-transport",
                        "armour",
                        "recon",
                        "fast-attack"
                    ],
                    "source": {
                        "faction": "legiones-astartes",
                        "subFactions": ["alpha-legion"]
                    },
                    "units": {
                        "exclude": [
                            {
                                "profiles": {
                                    "anyOf": ["Unique"]
                                }
                            }
                        ]
                    },
                    "effects": [
                        {
                            "kind": "trait",
                            "replace": {
                                "from": ["Legiones Astartes", "Alpha Legion"],
                                "to": "Shattered Legions"
                            }
                        },
                        {
                            "kind": "specialRule",
                            "rule": {
                                "id": "legion-specialists"
                            }
                        },
                        {
                            "kind": "trait",
                            "add": ["Exemplars of the Legion"]
                        }
                    ]
                }
            ]
        }
    },
