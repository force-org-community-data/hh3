                        "value": "I"
                    }
                }
            ]
        },
        "tainted-flesh-part-2": {
            "id": "tainted-flesh-part-2",
            "name": "Tainted Flesh",
            "selector": {
                "unitIds": ["rogue-psyker"]
            },
            "actions": [
                {
                    "kind": "specialRule",
                    "profiles": {
                        "noneOf": ["sergeant"]
                    },
                    "rule": {
                        "id": "aflame",
                        "value": "1"
                    }
                },
                {
                    "kind": "specialRule",
                    "profiles": {
                        "noneOf": ["sergeant"]
                    },
                    "rule": {
                        "id": "impact",
                        "value": "I"
                    }
                }
            ]
        },
        "tainted-flesh-second-discipline": {
            "id": "tainted-flesh-second-discipline",
            "name": "Second Psychic Discipline",
            "selector": {
                "unitIds": ["rogue-psyker"],
                "profiles": {
                    "anyOf": ["sergeant"]
                }
            },
            "actions": [
