{
    "$schema": "https://cdn.jsdelivr.net/gh/Force-Organization-Army-Builder/fo_data_validator@2/schema/sub-faction.schema.json",
    "id": "tainted-flesh",
    "version": "1.0.0",
    "name": "Tainted Flesh",
    "parent": {
        "faction": "imperialis-militia",
        "versions": ">=1.0.0 <2.0.0"
    },
    "when": {
        "if": "choice(allegiance) == traitor",
        "message": "This Provenance may only be selected for an Army with the Traitor Allegiance"
    },
    "specialRules": {
        "tainted-flesh": {
            "id": "tainted-flesh",
            "name": "Tainted Flesh",
            "text": "This Provenance may only be selected for an Army with the Traitor Allegiance. An Army with this Provenance gains the following benefits: All Models with the Irregulars Special Rule in this Army gain the Aflame (1) and Impact (I) Special Rules. Each Rogue Psyker Model in this Army may have up to two Psychic Disciplines selected for it from the options available on its profile instead of one."
        }
    },
    "upgrades": {
        "tainted-flesh-second-discipline": {
            "id": "tainted-flesh-second-discipline",
            "name": "Second Psychic Discipline",
            "description": "Each Rogue Psyker Model in this Army may have up to two Psychic Disciplines selected for it from the options available on its profile instead of one.",
            "perModel": {
                "type": "single"
            },
            "options": {
                "none": {
                    "id": "none",
                    "name": "None",
                    "cost": {
                        "points": 0
                    }
                },
                "biomancy": {
                    "id": "biomancy",
                    "name": "Biomancy",
                    "cost": {
                        "points": 20
                    },
                    "equipmentRefs": ["biomancy", "biomantic-rage"],
                    "effects": [
                        {
                            "kind": "specialRule",
                            "profiles": {
                                "anyOf": ["sergeant"]
                            },
                            "rule": {
                                "id": "impact",
                                "value": "Strength"
                            }
                        },
                        {
                            "kind": "trait",
                            "profiles": {
                                "anyOf": ["sergeant"]
                            },
                            "add": ["Biomancer"]
                        }
                    ]
                },
                "pyromancy": {
                    "id": "pyromancy",
                    "name": "Pyromancy",
                    "cost": {
                        "points": 10
                    },
                    "equipmentRefs": ["pyromancy"],
                    "effects": [
                        {
                            "kind": "specialRule",
                            "profiles": {
                                "anyOf": ["sergeant"]
                            },
                            "rule": {
                                "id": "explodes",
                                "value": "4+"
                            }
                        },
                        {
                            "kind": "trait",
                            "profiles": {
                                "anyOf": ["sergeant"]
                            },
                            "add": ["Pyromancer"]
                        }
                    ]
                },
                "telekinesis": {
                    "id": "telekinesis",
                    "name": "Telekinesis",
                    "cost": {
                        "points": 10
                    },
                    "equipmentRefs": ["telekinesis", "force-barrier"],
                    "effects": [
                        {
                            "kind": "specialRule",
                            "profiles": {
                                "anyOf": ["sergeant"]
                            },
                            "rule": {
                                "id": "shrouded",
                                "value": "4+"
                            }
                        },
                        {
                            "kind": "trait",
                            "profiles": {
                                "anyOf": ["sergeant"]
                            },
                            "add": ["Telekine"]
                        }
                    ]
                },
                "divination": {
                    "id": "divination",
                    "name": "Divination",
                    "cost": {
                        "points": 10
                    },
                    "equipmentRefs": [
                        "divination",
                        "every-strike-foreseen",
                        "foresights-blessing"
                    ],
                    "effects": [
                        {
                            "kind": "specialRule",
                            "profiles": {
                                "anyOf": ["sergeant"]
                            },
                            "rule": {
                                "id": "duellists-edge",
                                "value": "2"
                            }
                        },
                        {
                            "kind": "trait",
                            "profiles": {
                                "anyOf": ["sergeant"]
                            },
                            "add": ["Diviner"]
                        }
                    ]
                },
                "telepathy": {
                    "id": "telepathy",
                    "name": "Telepathy",
                    "cost": {
                        "points": 10
                    },
                    "equipmentRefs": ["telepathy", "mind-burst"],
                    "effects": [
                        {
                            "kind": "trait",
                            "profiles": {
                                "anyOf": ["sergeant"]
                            },
                            "add": ["Telepath"]
                        }
                    ]
                },
                "anathemata": {
                    "id": "anathemata",
                    "name": "Anathemata",
                    "cost": {
                        "points": 10
                    },
                    "equipmentRefs": [
                        "anathemata",
                        "breach-the-veil",
                        "seal-the-veil"
                    ],
                    "effects": [
                        {
                            "kind": "trait",
                            "profiles": {
                                "anyOf": ["sergeant"]
                            },
                            "add": ["Anathemata"]
                        }
                    ]
                }
            },
            "default": "none"
        }
    },
    "unitModifiers": {
